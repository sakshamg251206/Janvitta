{
  "name": "labhsetu",
  "version": "2.0.0",
  "private": true,
  "description": "Find the Indian government welfare schemes you are eligible for — bilingual (English/Hindi), private by design, with a small REST API.",
  "license": "MIT",
  "author": "Saksham Garg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sakshamg251206/Janvitta.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env backend/server.js",
    "dev": "node --env-file-if-exists=.env --watch backend/server.js",
    "test": "node --test \"tests/unit/**/*.test.js\" \"tests/api/**/*.test.js\"",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.0",
    "helmet": "^8.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2"
  }
}
