# Copy to .env and adjust. Every variable is optional; defaults are shown.
# `npm start` and `npm run dev` load .env automatically when it exists.

# development | production | test
NODE_ENV=development

# Address and port the server listens on.
HOST=0.0.0.0
PORT=3000

# Comma-separated origins allowed to call the API from a browser on another
# domain, e.g. https://partner.example.org. Leave empty for same-origin only
# (the bundled frontend needs nothing here). Use * to allow any origin.
CORS_ORIGINS=

# API rate limit per client IP: RATE_LIMIT_MAX requests per window.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# Set when running behind a reverse proxy or load balancer so client IPs (and
# therefore rate limiting) are correct. Usually 1 on Render, Railway, Fly.io.
TRUST_PROXY=false
